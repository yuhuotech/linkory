LINKORY_MYSQL_DSN="user:password@tcp(127.0.0.1:3306)/linkory?parseTime=true&charset=utf8mb4&loc=UTC"
LINKORY_ADDR=:8080
# Optional administration UI (build linkory-admin first); always behind HTTPS in production.
LINKORY_ADMIN_DIR=""
LINKORY_ADMIN_COOKIE_SECURE=true

# Extra trusted reverse-proxy peers, e.g. Docker host gateway IP/32 (comma-separated CIDRs).
# Empty uses only 127.0.0.1/32 and ::1/128; never trust arbitrary external forwarded headers.
LINKORY_ADMIN_TRUSTED_PROXIES=""
