# 复制为 deploy/.env 后填写；compose 会自动读取
LINKORY_MYSQL_DSN=linkory:CHANGE_ME@tcp(host.docker.internal:3306)/linkory?parseTime=true&charset=utf8mb4&loc=UTC
# 至少 32 字节的随机串：openssl rand -hex 32
LINKORY_JWT_SECRET=
# 宿主机映射端口（默认 8080）
LINKORY_PORT=8080
# 构建时 Go 模块代理（国内可用 https://goproxy.cn,direct）
# GOPROXY=https://goproxy.cn,direct
