# Copy to tools/deploy.env (git-ignored) and edit: the shared LAN test server used by
# `make deploy`, tools/deploy_linux_node.sh, tools/cross_e2e.sh and `make app-run`.
# No secrets here: the database password and JWT key are generated on the server (/etc/linkory/server.env).
DEPLOY_HOST=ubuntu@192.168.1.10   # ssh target (key-based login, passwordless sudo)
DEPLOY_PORT=8090
DEPLOY_DIR=/opt/linkory
DEPLOY_DB=linkory
